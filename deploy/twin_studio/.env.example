# Copy to deploy/twin_studio/.env to override defaults. NO SECRETS BELONG HERE:
# secrets are generated by `python deploy/twin_studio/init_secrets.py` into ./secrets/ (git-ignored).
EH_IMAGE_TAG=phase4
# Pinned MinIO build (from official source tags, see minio/Dockerfile)
EH_MINIO_IMAGE=eh-twin-minio:RELEASE.2025-10-15T17-29-55Z
# Object lock default retention for all three buckets
EH_RETENTION_MODE=GOVERNANCE
EH_RETENTION_DAYS=30
# Observation API host port (bound to 127.0.0.1 only)
EH_OBS_API_PORT=8081
# Reference API host port, ONLY used with the opt-in compose.reference-host.yaml (127.0.0.1 only)
EH_REF_API_PORT=8082
